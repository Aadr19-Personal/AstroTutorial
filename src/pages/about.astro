---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "About Me";

const identity = {
	firstName: "Adrian",
	country: "USA",
	occupation: "LSAT Tutor",
	hobbies: ["Mock Trial", "Tutoring", "Thrifting"],
}

const skills = ["HTML", "CSS", "JavaScript", "Astro", "React", "Node.js"];

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---
<BaseLayout pageTitle="About Me">
		<style is:global define:vars={{skillColor, fontWeight, textCase}}>
			h1 {
				color: purple;
				font-size: 4rem;
			}

			.skill {
			    color: var(--skillColor);
				font-weight: var(--fontWeight);
				text-transform: var(--textCase);
			}
		</style>
        <h2>... and my new Astro site!</h2>

        <p>I'm working through the tutorial, and this is the second page!</p>
        <p>This site will update as I complete the tutorial.</p>


		<p>Here are a few facts about me:</p>
		<ul>
			<li>My name is {identity.firstName}.</li>
			<li>I live in {identity.country} and I work as a {identity.occupation}.</li>
			{identity.hobbies.length >= 2 &&
			<li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
			}
		</ul>
		<p>My skills are:</p>
		<ul>
			{skills.map((skill) => <li class="skill">{skill}</li>)}
		</ul>

		{happy && <p>I'm happy to be learning Astro!</p>}
		{!finished && <p>I'm not finished with the tutorial yet.</p>}
		{goal === 3 ? <p>My goal is to finish the tutorial in 3 days.</p> : <p>My goal is not to finish the tutorial in 3 days.</p>}
</BaseLayout>